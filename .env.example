# Server
PORT=3000
HOST=0.0.0.0
NETWORK_IP=localhost

# Database (MongoDB Atlas). On Render: Network Access → allow 0.0.0.0/0 (or Render static egress IPs).
# URL-encode special characters in the password (@ → %40, etc.).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-strong-random-secret
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Optional app URLs
API_BASE_URL=http://localhost:3000
URL=http://localhost:3000/

# Allowed upload extensions
whiteListedExtensions=.jpg,.jpeg,.png,.gif,.mp4,.mov,.avi,.pdf,.doc,.docx,.txt,.m4a,.wav,.mp3

# Cloudinary — permanent cloud storage for images/videos/files (uploads never touch local disk)
# CLOUDINARY_CLOUD_NAME = "Cloud name" on Dashboard → Product environment credentials (NOT the API key "Key Name")
# CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET = from the same credentials panel
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Stripe Connect — marketplace payments (buyer card → seller payout, platform fee %)
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From Stripe Dashboard → Webhooks → endpoint signing secret (after adding /webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_...
PLATFORM_FEE_PERCENT=5
STRIPE_CURRENCY=usd
STRIPE_CONNECT_COUNTRY=US
STRIPE_MERCHANT_COUNTRY=US
STRIPE_MERCHANT_NAME=JHAMAT
STRIPE_APPLE_MERCHANT_ID=merchant.com.app.clothShopFlutter
STRIPE_GOOGLE_PAY_TEST_ENV=true

# Firebase Admin (FCM) — use ONE of these (required on Render; file is not in git):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}   # minified one-line JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=...                              # base64 of the JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./jhamat-app-firebase-adminsdk-fbsvc-686f30ea30.json
